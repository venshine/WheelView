<?xml version="1.0" encoding="utf-8"?>
<com.wx.wheelview.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="24dp">

        <include layout="@layout/include_toolbar" />

        <!-- 预览 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lab_preview" />

                <TextView
                    android:id="@+id/skin_label"
                    style="@style/Text.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <com.wx.wheelview.widget.WheelView
                    android:id="@+id/preview_wheel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View style="@style/WheelFade.Top" />

                <View style="@style/WheelFade.Bottom" />
            </FrameLayout>
        </LinearLayout>

        <!-- 参数 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lab_skin"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/skin_common"
                    style="@style/Text.Numeric"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="Common"
                    android:textColor="@color/segment_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/skin_holo"
                    style="@style/Text.Numeric"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="Holo"
                    android:textColor="@color/segment_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/skin_none"
                    style="@style/Text.Numeric"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_item"
                    android:gravity="center"
                    android:text="None"
                    android:textColor="@color/segment_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 三个滑块由 StyleLabActivity.addSlider 动态添加 -->
            <LinearLayout
                android:id="@+id/slider_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/lab_selected_color"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/swatch_row"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/toggle_bold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_toggle_chip"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/toggle_bold_label"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawablePadding="6dp"
                        android:duplicateParentState="true"
                        android:text="@string/lab_bold"
                        android:textColor="@color/toggle_text"
                        android:textSize="14sp" />
                </FrameLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="0dp" />

                <FrameLayout
                    android:id="@+id/toggle_loop"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_toggle_chip"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/toggle_loop_label"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:drawablePadding="6dp"
                        android:duplicateParentState="true"
                        android:text="@string/lab_loop"
                        android:textColor="@color/toggle_text"
                        android:textSize="14sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 生成的代码 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_code"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/lab_code" />

                <TextView
                    android:id="@+id/copy_code"
                    style="@style/Button.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="@string/lab_copy_code"
                    android:textSize="12sp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/code_text"
                    style="@style/Text.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.45"
                    android:textSize="11.5sp" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</com.wx.wheelview.widget.NestedScrollView>
