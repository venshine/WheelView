<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色主题色板；深色版本在 values-night/colors.xml，两边的颜色名必须一一对应 -->
<resources>
    <color name="bg">#F4F2EE</color>
    <color name="surface">#FFFFFF</color>
    <!-- surface 的全透明版本，用于滚轮上下渐隐 -->
    <color name="surface_clear">#00FFFFFF</color>
    <color name="border">#E4DFD6</color>
    <color name="line">#D9D3C8</color>
    <color name="text">#16181D</color>
    <color name="text_muted">#5C6370</color>
    <color name="text_dim">#646B77</color>
    <color name="text_sub">#3A3F48</color>
    <color name="code_bg">#FBFAF7</color>
    <color name="code_border">#E4DFD6</color>
    <color name="code_text">#24292F</color>
    <color name="code_comment">#646B77</color>
    <color name="code_string">#2F7D4F</color>
    <color name="chevron">#9AA0AB</color>
    <color name="seg_bg">#EFECE6</color>
    <color name="seg_on">#FFFFFF</color>
    <color name="accent">#FF7A3D</color>
    <!-- 强调色用作文字时的颜色：浅色背景上橙色对比度不足，换成加深的同色系 -->
    <color name="accent_ink">#C2410C</color>
    <color name="accent_soft">#1FFF7A3D</color>
    <color name="on_accent">#1A0E06</color>
    <color name="wheel_text">#3A3F48</color>
    <color name="wheel_selected">#16181D</color>
    <color name="toast_bg">#16181D</color>
    <color name="toast_text">#F4F2EE</color>
    <color name="handle">#D0CBC1</color>
    <color name="ripple">#1416181D</color>
    <!-- 库自带 WheelViewDialog 始终是浅色对话框（见 styles.xml），主色固定用浅色下的加深橙，不随深色切换 -->
    <color name="dialog_accent">#C2410C</color>
</resources>
